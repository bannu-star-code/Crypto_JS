<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create an account</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0b1020; color: #e8ecf5; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
    main { width: min(460px, calc(100% - 40px)); padding: 32px; border: 1px solid #27324a; border-radius: 16px; background: #121a2b; }
    h1 { margin-top: 0; }
    p, label { color: #aab4ca; }
    form { display: grid; gap: 16px; }
    label { display: grid; gap: 8px; }
    input { padding: 12px; border: 1px solid #35425e; border-radius: 8px; background: #0b1020; color: #e8ecf5; font: inherit; }
    .errors { color: #f6d98c; }
    button { padding: 13px; border: 0; border-radius: 9px; background: #7dd3fc; color: #07111e; font: inherit; font-weight: 700; cursor: pointer; }
    a { color: #7dd3fc; }
  </style>
</head>
<body>
  <main>
    <h1>Create an account</h1>
    <p>Sign up to view your portfolio and manage spot orders.</p>
    <% if (errors.length) { %>
      <ul class="errors" role="alert"><% for (const error of errors) { %><li><%= error %></li><% } %></ul>
    <% } %>
    <form method="post" action="/signup/">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Username<input type="text" name="username" autocomplete="username" maxlength="150" required></label>
      <label>Password<input type="password" name="password" autocomplete="new-password" required></label>
      <label>Confirm password<input type="password" name="password_confirmation" autocomplete="new-password" required></label>
      <button type="submit">Sign up</button>
    </form>
    <p>Already have an account? <a href="/login/">Log in</a>.</p>
    <p><a href="/">Back to coin search</a></p>
  </main>
</body>
</html>
