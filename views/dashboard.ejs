<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Search coin prices</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #0b1020;
      color: #e8ecf5;
    }
    body { margin: 0; min-height: 100vh; }
    main { width: min(850px, calc(100% - 40px)); margin: 56px auto; }
    .eyebrow { color: #7dd3fc; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 10px 0 8px; font-size: clamp(2rem, 5vw, 3.25rem); }
    .subtitle { color: #aab4ca; margin: 0 0 32px; }
    section { padding: 24px; border: 1px solid #27324a; border-radius: 16px; background: #121a2b; margin-bottom: 20px; }
    h2 { margin: 0 0 18px; font-size: 1.15rem; }
    form.search { display: flex; gap: 12px; margin-bottom: 24px; }
    input { flex: 1; min-width: 0; padding: 14px 16px; border: 1px solid #35425e; border-radius: 10px; background: #121a2b; color: #e8ecf5; font: inherit; }
    button { padding: 14px 20px; border: 0; border-radius: 10px; background: #7dd3fc; color: #07111e; font: inherit; font-weight: 700; cursor: pointer; }
    button:hover { background: #a5e3ff; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 14px 12px; border-bottom: 1px solid #27324a; text-align: left; }
    th { color: #aab4ca; font-size: .85rem; }
    .price { text-align: right; font-weight: 700; }
    .rank, .hint { color: #aab4ca; }
    .notice { border-color: #725b2b; background: #211d13; color: #f6d98c; }
    .hint { margin-top: 22px; color: #8793aa; font-size: .9rem; }
    nav { display: flex; gap: 18px; margin: 0 0 32px; align-items: center; }
    nav a { color: #7dd3fc; text-decoration: none; }
    nav a:hover { text-decoration: underline; }
    nav form { display: inline; margin: 0 0 0 auto; }
    nav button { padding: 6px 10px; }
  </style>
</head>
<body>
  <main>
    <%- include("partials/nav", { currentPage: "dashboard" }) %>
    <div class="eyebrow">CoinGecko market data</div>
    <h1>Search coin prices</h1>
    <p class="subtitle">Search by coin name or ticker symbol to see current INR prices.</p>

    <form class="search" method="get" action="/">
      <input type="search" name="q" value="<%= query %>" placeholder="Try Bitcoin, BTC, or Ethereum"
        aria-label="Coin name or ticker symbol" maxlength="100" required>
      <button type="submit">Search</button>
    </form>

    <% if (error) { %>
      <section class="notice" role="alert"><h2>Search unavailable</h2><p><%= error %></p></section>
    <% } else if (searched && coins.length) { %>
      <section>
        <h2>Results for “<%= query %>”</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Coin</th><th>Symbol</th><th>Market rank</th><th class="price">Price (INR)</th></tr></thead>
            <tbody>
              <% for (const coin of coins) { %>
                <tr>
                  <td><%= coin.name %></td>
                  <td><%= coin.symbol %></td>
                  <td class="rank"><%= coin.market_cap_rank ? `#${coin.market_cap_rank}` : "—" %></td>
                  <td class="price"><%= coin.price_inr !== null
                    ? `₹${coin.price_inr.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
                    : "Price unavailable" %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    <% } else if (searched) { %>
      <section><h2>No matching coins</h2><p>Try another coin name or ticker symbol.</p></section>
    <% } %>
    <p class="hint">Prices are public market quotes from CoinGecko, not CoinSwitch execution prices. Coin symbols can be shared by multiple tokens, so check the coin name too.</p>
  </main>
</body>
</html>
